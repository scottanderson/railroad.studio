{
    "name": "Railroad Studio",
    "version": "1.0.0",
    "repository": {
        "url": "git+https://github.com/scottanderson/railroad.studio.git"
    },
    "scripts": {
        "build": "webpack --mode=development",
        "watch": "webpack --mode=development --watch",
        "start": "webpack server --mode=development",
        "check": "npx prettier -c . && npx eslint .",
        "format": "npx prettier -w . && npx eslint . --fix",
        "build:prod": "webpack --mode=production"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@svgdotjs/svg.js": "^3.2.7",
        "@total-typescript/ts-reset": "^0.6.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^10.8.0",
        "eslint-config-google": "^0.14.0",
        "eslint-webpack-plugin": "^6.0.0",
        "globals": "^17.8.0",
        "svg-pan-zoom": "^3.6.2",
        "ts-loader": "^9.6.2",
        "typescript": "^7.0.2",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^6.0.0"
    }
}
