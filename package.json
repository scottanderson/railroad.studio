{
    "name": "Railroad Studio",
    "version": "1.0.0",
    "repository": {
        "url": "git+https://github.com/scottanderson/railroad.studio.git"
    },
    "scripts": {
        "build": "webpack --mode=development",
        "watch": "webpack --mode=development --watch",
        "start": "webpack server --mode=development",
        "check": "npx prettier -c . && npx eslint .",
        "format": "npx prettier -w . && npx eslint . --fix",
        "build:prod": "webpack --mode=production",
        "sync": "aws s3 sync railroad.studio s3://railroad.studio"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@stylistic/eslint-plugin-ts": "^4.1.0",
        "@svgdotjs/svg.js": "^3.2.4",
        "@total-typescript/ts-reset": "^0.6.0",
        "@typescript-eslint/eslint-plugin": "^8.25.0",
        "eslint": "^9.21.0",
        "eslint-config-google": "^0.14.0",
        "eslint-webpack-plugin": "^5.0.0",
        "globals": "^16.0.0",
        "svg-pan-zoom": "^3.6.1",
        "ts-loader": "^9.5.1",
        "typescript": "^5.8.2",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.0"
    }
}
