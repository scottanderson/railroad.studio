{
    "printWidth": 120,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "overrides": [
        {
            "files": ["*.css", "*.html", "*.yml", "tsconfig.json"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.js", "*.mjs", "*.ts"],
            "options": {
                "quoteProps": "consistent"
            }
        }
    ]
}
